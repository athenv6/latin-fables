<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">

<link href="https://fonts.googleapis.com/css2?family=MedievalSharp&display=swap" rel="stylesheet">

<style>
body {
  font-family: 'MedievalSharp', cursive;
  display: flex;
  justify-content: center;
  align-items: center;
  height: 100vh;
  margin: 0;
  background: #f5f5f5;
}

.box {
  text-align: center;
  background: white;
  padding: 30px;
  border-radius: 10px;
  width: 400px;
}

input {
  padding: 5px;
  margin: 5px;
  width: 200px;
}

button {
  margin-top: 10px;
  padding: 8px 15px;
  cursor: pointer;
}
</style>
</head>

<body>

<div class="box">

<h2>Fable Quiz</h2>

<p>fimum → <input id="f1"></p>
<p>escam → <input id="f2"></p>
<p>iaspis → <input id="f3"></p>
<p>sorde → <input id="f4"></p>
<p>messis → <input id="f5"></p>

<button onclick="check()">Check</button>

<p id="result"></p>

</div>

<script>
function check() {

let score = 0;

function test(id, correct) {
let val = document.getElementById(id).value.trim().toLowerCase();
if (val === correct) score++;
}

test("f1", "terram");
test("f2", "cibum");
test("f3", "sapientia");
test("f4", "immunditia");
test("f5", "fructus");

let msg = "";

if (score === 5) {
msg = "Correct! 5/5";
} else {
msg = "Wrong: " + score + "/5 correct";
}

document.getElementById("result").innerText = msg;
}
</script>

</body>
</html>
